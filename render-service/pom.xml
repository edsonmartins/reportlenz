<?xml version="1.0" encoding="UTF-8"?>
<!--
  ReportLenz · backend Java (ADR-026): projeto multi-módulo.

    reportlenz-core                 → Java puro (pipeline, G7, gates, MotorReportLenz)
    reportlenz-spring-boot-starter  → auto-configuração para aplicações Spring Boot 4
    reportlenz-app                  → o render-service standalone (starter + main)

  Embarca a JasperReports Library 7.0.7 como DEPENDÊNCIA, sem modificação
  (fronteira LGPLv3 — ADR-006; matriz modular do ADR-007/nota 004).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>br.com.archbase</groupId>
  <artifactId>reportlenz-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>ReportLenz · parent</name>
  <description>Render JRXML 7 contract-first (Push) com a JasperReports Library 7.0.7</description>
  <url>https://github.com/edsonmartins/reportlenz</url>

  <!-- Metadados exigidos pelo Maven Central (ADR-026 §4) -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>ReportLenz</name>
      <url>https://github.com/edsonmartins/reportlenz</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/edsonmartins/reportlenz</url>
    <connection>scm:git:https://github.com/edsonmartins/reportlenz.git</connection>
    <developerConnection>scm:git:git@github.com:edsonmartins/reportlenz.git</developerConnection>
  </scm>

  <properties>
    <java.version>21</java.version>
    <jasperreports.version>7.0.7</jasperreports.version>

    <!--
      Publicação no Maven Central: OPT-IN por módulo (como no archflow). O
      default é true (NÃO publica) e só reportlenz-core e
      reportlenz-spring-boot-starter viram false no próprio pom: esquecer um
      módulo novo significa "não publicou" — o erro barato, já que o Central
      não aceita remover uma versão publicada.
    -->
    <reportlenz.publish.skip>true</reportlenz.publish.skip>
    <!-- Publica sozinho ao final; ensaio: -Dreportlenz.publish.auto=false (dry-run). -->
    <reportlenz.publish.auto>true</reportlenz.publish.auto>
    <!--
      Espera até VALIDADO, não até publicado (archflow, 1.4.0: esperar o
      "published" estourou o timeout com a publicação a caminho, e o build
      falhou dizendo que deu errado quando deu certo).
    -->
    <reportlenz.publish.waitUntil>validated</reportlenz.publish.waitUntil>
    <reportlenz.publish.waitMaxTime>3600</reportlenz.publish.waitMaxTime>
    <maven.source.plugin.version>3.3.0</maven.source.plugin.version>
    <maven.javadoc.plugin.version>3.6.3</maven.javadoc.plugin.version>
    <maven.gpg.plugin.version>3.2.7</maven.gpg.plugin.version>
    <central.publishing.plugin.version>0.10.0</central.publishing.plugin.version>
    <flatten.plugin.version>1.6.0</flatten.plugin.version>
  </properties>

  <!--
    Publicação no Maven Central (ADR-026 §4) — mesmo processo do archflow:

        mvn -B deploy -Pmaven-central -DskipTests \
            -pl reportlenz-core,reportlenz-spring-boot-starter \
            -s ../.maven-settings.xml.template

    Variáveis: MAVEN_CENTRAL_USERNAME / MAVEN_CENTRAL_TOKEN (token do
    central.sonatype.com) e MAVEN_GPG_PASSPHRASE; chave GPG importada antes.
    Namespace br.com.archbase: o mesmo já verificado para os artefatos do Archbase.
  -->
  <profiles>
    <profile>
      <id>maven-central</id>
      <build>
        <plugins>
          <!-- Sources e javadoc: obrigatórios no Central. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven.source.plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven.javadoc.plugin.version}</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>

          <!-- Assinatura GPG, também obrigatória (pinentry loopback vem do settings/gpg.conf). -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven.gpg.plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>

          <!--
            POM publicado ACHATADO (lição do archflow, v1.1.0 recusada no Central
            por "License/SCM/Developers missing" e versões de dependência ausentes):
            o reportlenz-parent NÃO é publicado, então o <parent> que os módulos
            declaram não existiria no Central. O modo ossrh publica um POM sem
            <parent>, com versões resolvidas (inclusive as do BOM do Spring Boot)
            e licenses/scm/developers/url/description embutidos — e quem depende
            do starter não herda o spring-boot-starter-parent.
          -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <version>${flatten.plugin.version}</version>
            <configuration>
              <flattenMode>ossrh</flattenMode>
            </configuration>
            <executions>
              <execution>
                <id>flatten</id>
                <phase>process-resources</phase>
                <goals><goal>flatten</goal></goals>
              </execution>
              <execution>
                <id>flatten-clean</id>
                <phase>clean</phase>
                <goals><goal>clean</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.publishing.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Por propriedade (não literal): -D vence, e o dry-run sobe sem publicar. -->
              <autoPublish>${reportlenz.publish.auto}</autoPublish>
              <waitUntil>${reportlenz.publish.waitUntil}</waitUntil>
              <waitMaxTime>${reportlenz.publish.waitMaxTime}</waitMaxTime>
              <skipPublishing>${reportlenz.publish.skip}</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <modules>
    <module>reportlenz-core</module>
    <module>reportlenz-spring-boot-starter</module>
    <module>reportlenz-app</module>
  </modules>
</project>
