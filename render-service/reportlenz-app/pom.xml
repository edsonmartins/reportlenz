<?xml version="1.0" encoding="UTF-8"?>
<!--
  ReportLenz · serviço de render (RFC-003, tarefa phase-1/1.1).

  Embarca a JasperReports Library 7.0.7 como dependência, sem modificação
  (fronteira LGPLv3 — ADR-006). Matriz modular do JR7 conforme ADR-007,
  validada contra o Maven Central em 2026-07-09 (nota de design 004):
  PDF e fontes NÃO vêm no core — declarar explicitamente.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.reportlenz</groupId>
    <artifactId>reportlenz-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>reportlenz-render-service</artifactId>
  <packaging>jar</packaging>
  <name>ReportLenz · serviço de render</name>
  <description>Render JRXML contract-first (Push) com JasperReports Library 7.0.7 — preview e batch</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Autenticação (ADR-017): resource server JWT emitido pelo Keycloak -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Fila do batch (RFC-003 §4): Redis como transporte (decisão do usuário) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Estado durável dos jobs + idempotência: SQLite para começar (decisão do usuário) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Migrations versionadas (ADR-018): SQL portável SQLite/PostgreSQL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.2.0</version>
    </dependency>
    <!-- PostgreSQL (ADR-009/change migracao-postgresql): produção via REPORTLENZ_DB_URL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Núcleo de render (ADR-026): JasperReports 7.0.7 (matriz do ADR-007), G7,
         filtro de classes, pipeline e gates — dependências vêm dele. -->
    <dependency>
      <groupId>dev.reportlenz</groupId>
      <artifactId>reportlenz-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Observabilidade (RFC-003 §7, tarefa 6.1): Observation API → métricas + traces -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Boot 4: auto-config de métricas Micrometer saiu do actuator p/ módulo próprio -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-micrometer-metrics</artifactId>
    </dependency>
    <!-- Métricas em formato Prometheus (o VictoriaMetrics raspa /actuator/prometheus) -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Traces via OTel → OTLP (Tempo); endpoint por env -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4: suporte a MockMvc saiu do starter-test para módulo próprio -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JWTs de teste (ADR-017): jwt() no MockMvc -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Extração de texto de PDF nos testes (prova de acentuação pt-BR, tarefa 1.2) -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.7</version>
      <scope>test</scope>
    </dependency>
    <!-- Leitura dos códigos de barras do PNG renderizado (matriz do catálogo, ADR-022) -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.4</version>
      <scope>test</scope>
    </dependency>
    <!-- Espera assíncrona nos testes do batch -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Storage MinIO/S3 (tarefa 5.4, padrão MEDIASTORE) — SDK v2, path-style -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.47.4</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
      <version>2.47.4</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
