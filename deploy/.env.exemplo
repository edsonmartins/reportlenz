# Ambiente de HOMOLOGAÇÃO do ReportLenz (ADR-019). Copie para deploy/.env e troque
# TODOS os valores "troque-*". Este arquivo NÃO vai para produção: lá os segredos
# vêm do secret manager da plataforma.

# --- endereços públicos (o que o navegador usa) ---
DESIGNER_URL=http://localhost:8080
KEYCLOAK_URL_PUBLICA=http://localhost:8180

# --- PostgreSQL (templates, jobs e o banco do Keycloak) ---
POSTGRES_USER=reportlenz
POSTGRES_PASSWORD=troque-postgres

# --- Redis (fila + compile cache + rate limit). SEMPRE com senha e em rede privada:
# o compile cache guarda JasperReport serializado (ADR-016, risco residual).
REDIS_PASSWORD=troque-redis

# --- S3 das saídas (PDFs). As imagens oficiais da MinIO não são mais publicadas;
# pgsty/minio (rebuild comunitário) aprovada em 2026-11-26 (nota-010). Tag FIXA.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_ACCESS_KEY=reportlenz
MINIO_SECRET_KEY=troque-minio-segredo

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-keycloak-admin
# Segredo do client confidencial do backend de domínio (client_credentials).
REPORTLENZ_BATCH_CLIENT_SECRET=troque-segredo-batch
# Senhas TEMPORÁRIAS dos usuários de teste (troca obrigatória no 1º login).
HOMOLOG_SENHA_DESIGNER=troque-designer
HOMOLOG_SENHA_PUBLICADOR=troque-publicador

# --- IA (opcional). Vazio = assistente indisponível (503), o designer segue.
OPENROUTER_API_KEY=
# Origens das aplicações que embutem o @archbase/reportlenz-designer-react com apiBaseUrl de OUTRA origem
# (ADR-025), separadas por vírgula. Vazio = só mesma origem. O E2E usa a aplicação de teste em :5300.
REPORTLENZ_CORS_ORIGENS=http://localhost:5300
# Prefixos de URL que imagens de template podem buscar (ADR-016), separados por vírgula.
REPORTLENZ_RECURSOS_URLS_PERMITIDAS=
# Tracing: 0 sem collector OTLP; defina o endpoint e suba a amostragem quando houver.
OTEL_SAMPLING=0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
